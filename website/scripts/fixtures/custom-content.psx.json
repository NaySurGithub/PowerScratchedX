{
  "format": "powerscratchedx",
  "formatVersion": 1,
  "meta": { "name": "CustomDemo", "version": "1.0.0", "author": "test", "description": "custom items and blocks" },
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "item_define", "x": 20, "y": 20,
          "fields": { "ID": "ruby_sword", "NAME": "Ruby Sword", "KIND": "sword", "TIER": "diamond", "TEXTURE": "diamond_sword" },
          "inputs": { "PROPS": { "block": {
            "type": "iprop_damage", "fields": { "VALUE": 9 },
            "next": { "block": { "type": "iprop_glint", "fields": { "VALUE": "true" },
              "next": { "block": { "type": "iprop_cooldown", "fields": { "VALUE": 3 } } } } }
          } } }
        },
        {
          "type": "item_define", "x": 20, "y": 200,
          "fields": { "ID": "ruby_helmet", "NAME": "Ruby Helmet", "KIND": "helmet", "TIER": "diamond", "TEXTURE": "diamond_helmet" },
          "inputs": { "PROPS": { "block": { "type": "iprop_armor", "fields": { "POINTS": 4, "TOUGHNESS": 2 } } } }
        },
        {
          "type": "item_define", "x": 20, "y": 360,
          "fields": { "ID": "golden_pie", "NAME": "Golden Pie", "KIND": "food", "TIER": "wooden", "TEXTURE": "pumpkin_pie" },
          "inputs": { "PROPS": { "block": { "type": "iprop_food", "fields": { "NUTRITION": 8, "SATURATION": 1.2, "ALWAYS": "true" } } } }
        },
        {
          "type": "item_define", "x": 20, "y": 520,
          "fields": { "ID": "magic_wand", "NAME": "Magic Wand", "KIND": "item", "TIER": "wooden", "TEXTURE": "blaze_rod" },
          "inputs": { "PROPS": { "block": { "type": "iprop_usable", "fields": { "VALUE": 0.1 },
            "next": { "block": { "type": "iprop_stack", "fields": { "VALUE": 1 } } } } } }
        },
        {
          "type": "block_define", "x": 400, "y": 20,
          "fields": { "ID": "ruby_block", "NAME": "Ruby Block", "TEXTURE": "diamond_block" },
          "inputs": { "PROPS": { "block": { "type": "bprop_hardness", "fields": { "VALUE": 5 },
            "next": { "block": { "type": "bprop_light", "fields": { "VALUE": 10 } } } } } }
        },
        {
          "type": "evt_item_use", "x": 400, "y": 200, "fields": { "ID": "magic_wand" },
          "inputs": { "DO": { "block": {
            "type": "player_send_message",
            "inputs": { "PLAYER": { "shadow": { "type": "player_current" } }, "TEXT": { "shadow": { "type": "text", "fields": { "TEXT": "§dZap!" } } } },
            "next": { "block": { "type": "player_add_effect", "fields": { "EFFECT": "speed" },
              "inputs": { "PLAYER": { "shadow": { "type": "player_current" } }, "SECONDS": { "shadow": { "type": "math_number", "fields": { "NUM": 10 } } }, "LEVEL": { "shadow": { "type": "math_number", "fields": { "NUM": 2 } } } } } }
          } } }
        },
        {
          "type": "evt_item_hit", "x": 400, "y": 420, "fields": { "ID": "ruby_sword" },
          "inputs": { "DO": { "block": {
            "type": "target_set_fire",
            "inputs": { "SECONDS": { "shadow": { "type": "math_number", "fields": { "NUM": 4 } } } }
          } } }
        },
        {
          "type": "evt_block_use", "x": 400, "y": 560, "fields": { "ID": "ruby_block" },
          "inputs": { "DO": { "block": {
            "type": "player_send_message",
            "inputs": { "PLAYER": { "shadow": { "type": "player_current" } }, "TEXT": { "shadow": { "type": "text", "fields": { "TEXT": "Shiny!" } } } }
          } } }
        },
        {
          "type": "cmd_hat", "x": 800, "y": 20, "fields": { "NAME": "kit", "DESC": "Give the ruby kit", "PERM": "" },
          "inputs": { "DO": { "block": {
            "type": "player_give_item",
            "inputs": { "PLAYER": { "shadow": { "type": "player_current" } }, "ITEM": { "shadow": { "type": "text", "fields": { "TEXT": "" } }, "block": { "type": "item_full_id", "fields": { "ID": "ruby_sword" } } }, "COUNT": { "shadow": { "type": "math_number", "fields": { "NUM": 1 } } } },
            "next": { "block": { "type": "player_give_item",
              "inputs": { "PLAYER": { "shadow": { "type": "player_current" } }, "ITEM": { "shadow": { "type": "text", "fields": { "TEXT": "ruby_helmet" } } }, "COUNT": { "shadow": { "type": "math_number", "fields": { "NUM": 1 } } } } } }
          } } }
        }
      ]
    }
  }
}
